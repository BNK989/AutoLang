<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the AutoLang mark (src/AutoLang.Host/IconArt.cs, linked so the tray and the shipped art never drift)
       into the exe icon and the MSIX tile images. Run after changing the art; the outputs are checked in.
       Usage: dotnet run with this project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AutoLang.Assets</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\AutoLang.Host\IconArt.cs" Link="IconArt.cs" />
  </ItemGroup>

</Project>
