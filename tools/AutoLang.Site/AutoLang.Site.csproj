<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the website in docs/ from the templates in site/ and the translations in site/strings/.
       Run after editing either; the outputs are checked in (GitHub Pages serves docs/).
       Usage: dotnet run with this project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoLang.Site</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
