<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tray host (PLAN.md §5, M2-M4): low-level hook that only enqueues, session tracker, engine decision at word
       boundaries, correction injected from a worker thread (per-app typing method), undo / force hotkeys, default
       app exclusions, password-field and admin-window skip, hook watchdog and restart-on-crash, no persistence of
       typed text. WinForms gives the tray icon; WPF is pulled in for the UI Automation client.
       Ships as an MSIX (packaging/build-msix.ps1) or a single portable exe (packaging/build-portable.ps1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>AutoLang.Host</RootNamespace>
    <AssemblyName>AutoLang</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Background GC keeps pauses short; the hook callback must answer within a few ms. -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Rendered by tools/AutoLang.Assets from IconArt.cs. -->
    <ApplicationIcon>AutoLang.ico</ApplicationIcon>
    <!-- The MSIX version is this plus ".0" (packaging/build-msix.ps1); the Store requires the 4th part to stay 0. -->
    <Version>0.5.0</Version>
    <Product>AutoLang</Product>
    <Company>AutoLang</Company>
    <Description>Fixes words typed in the wrong keyboard layout and switches the layout for you.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WPF implicit-usings set omits System.IO. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools/AutoLang.Screens draws the tray menu and Languages window for the Store screenshots. -->
    <InternalsVisibleTo Include="AutoLang.Screens" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoLang.Engine\AutoLang.Engine.csproj" />
    <ProjectReference Include="..\AutoLang.Session\AutoLang.Session.csproj" />
  </ItemGroup>

  <!-- The word lists are the engine's dictionaries; they ship next to the exe. One file per language, named by
       the ISO 639-1 code of the installed layout's language (en_50k.txt, he_50k.txt, ...). -->
  <ItemGroup>
    <!-- Embedded, so the portable build is one exe with no data folder beside it; WordLists.Find reads "words/<file>". -->
    <EmbeddedResource Include="..\..\data\words\*.txt" LogicalName="words/%(Filename)%(Extension)" />
    <!-- Tray menu icons: Fluent UI System Icons, 16 px regular (MIT, Icons/LICENSE.txt). MenuIcons reads "icons/<name>.svg". -->
    <EmbeddedResource Include="Icons\*.svg" LogicalName="icons/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
