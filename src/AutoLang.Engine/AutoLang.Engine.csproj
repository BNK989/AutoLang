<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure decision engine. No Windows dependencies: everything the host knows about keyboards
       arrives as data (KeyboardLayoutTable), so this builds and tests anywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoLang.Engine</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
