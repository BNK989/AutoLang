<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>autolang-ibus</AssemblyName>
    <RootNamespace>AutoLang.Linux</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoLang.Engine\AutoLang.Engine.csproj" />
    <ProjectReference Include="..\..\src\AutoLang.Session\AutoLang.Session.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\words\*.txt" LogicalName="words/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
