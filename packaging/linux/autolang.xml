<?xml version="1.0" encoding="utf-8"?>
<!-- IBus component for AutoLang. ibus-daemon reads this from /usr/share/ibus/component, starts <exec> when the
     engine is first selected, and expects the process to own <name> on its bus. build-deb.sh fills in @VERSION@. -->
<component>
    <name>org.freedesktop.IBus.AutoLang</name>
    <description>AutoLang: fixes text typed in the wrong keyboard layout</description>
    <exec>/usr/lib/autolang/autolang --ibus</exec>
    <version>@VERSION@</version>
    <author>AutoLang</author>
    <license>MIT</license>
    <homepage>https://bnk989.github.io/AutoLang/</homepage>
    <textdomain>autolang</textdomain>
    <engines>
        <engine>
            <name>autolang</name>
            <language>other</language>
            <license>MIT</license>
            <author>AutoLang</author>
            <icon>/usr/share/autolang/autolang.png</icon>
            <layout>us</layout>
            <longname>AutoLang</longname>
            <description>Types in your layouts and fixes words typed in the wrong one</description>
            <rank>0</rank>
            <symbol>AL</symbol>
        </engine>
    </engines>
</component>
